# Copy this file to secrets.env and set your own values.
# secrets.env is gitignored — never commit it.

# Postgres superuser (database administration)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin

# Database name
POSTGRES_DB=checker

# Checker application user (API connects with this account)
CHECKER_DB_USER=checker
CHECKER_DB_PASSWORD=change-me-checker-app
CHECKER_DB_NAME=checker
CHECKER_DB_HOST=db
CHECKER_DB_PORT=5432

# JWT signing secret for user sessions
JWT_SECRET=change-me-jwt-secret
